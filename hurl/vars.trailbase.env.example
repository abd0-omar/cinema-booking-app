# Copy to hurl/vars.trailbase.env (gitignored) and adjust URLs if needed.
trailbase_url=http://127.0.0.1:4000
api_base_url=http://127.0.0.1:3000

# Email is always admin@localhost for a fresh local Trailbase DB.
# Password: on first init Trailbase logs a random password — it is NOT "secret".
# Either copy it from the Trailbase startup logs, or align with this file, e.g.:
#   trail --data-dir ./traildepot user change-password admin@localhost 'secret'
# Some hosted demos document fixed credentials; use those for that host only.
trailbase_email=admin@localhost
trailbase_password=secret
